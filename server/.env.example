# Copie para server/.env. Esse arquivo local não deve ser commitado.
# Nenhum destes valores entra no frontend Vite.

NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# URL pública da VPS (mesmo host da UI e da API). Várias separadas por vírgula.
# Em desenvolvimento, localhost/127.0.0.1/[::1] e LAN privada já são aceitos em qualquer porta.
CORS_ORIGIN=https://app.seudominio.com

# Cookies de sessão. Em produção com HTTPS use Secure=true.
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
SESSION_TTL_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Build do React (relativo a server/ ou absoluto).
FRONTEND_DIST=../dist

# Arquivos privados (substitui Storage do Supabase).
DATA_DIR=./data/files

# PostgreSQL segcrm
DATABASE_URL=
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=segcrm
PGSSLMODE=disable

# Token da rota GET /admin/database. Deixe vazio para a rota responder 404.
DIAGNOSTIC_TOKEN=

# IA (somente no servidor)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=
