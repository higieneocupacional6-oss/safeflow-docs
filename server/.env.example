# Copie para server/.env. Esse arquivo local não deve ser commitado.
# Nenhum destes valores entra no frontend Vite.

NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# Origem do React local. Várias origens podem ser separadas por vírgula.
CORS_ORIGIN=http://localhost:3080

# Cookies de sessão. Em produção use COOKIE_SECURE=true.
# SameSite=none exige Secure=true (HTTPS).
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SESSION_TTL_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Preencha DATABASE_URL ou os campos PG*. Deixe em branco para subir só o /health.
DATABASE_URL=

PGHOST=127.0.0.1
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=segcrm
PGSSLMODE=disable

# Token da rota GET /admin/database. Deixe vazio para a rota responder 404.
DIAGNOSTIC_TOKEN=
